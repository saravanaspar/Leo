abi_version 1

# Leo CUDA ABI v1 - canonical build-time definition
[config]
u32 neuron_count
u32 block_count
u32 neurons_per_block
u32 branches_per_neuron
u32 synapses_per_neuron
u32 input_fanout
u32 max_active_per_block
u32 max_active_global
u32 context_max_order
u32 context_embedding_dim
u32 context_slots_per_order
u32 context_probe_limit
u32 context_confidence_observations
u32 refractory_ticks
f32 branch_decay
f32 membrane_decay
f32 fatigue_decay
f32 fatigue_gain
f32 target_activity
f32 threshold_homeostasis_rate
f32 population_inhibition_rate
f32 population_inhibition_max
f32 adaptation_fast_decay
f32 adaptation_medium_decay
f32 adaptation_slow_decay
f32 adaptation_fast_gain
f32 adaptation_medium_gain
f32 adaptation_slow_gain
f32 membrane_reset_fraction
f32 output_learning_rate
f32 recurrent_learning_rate
f32 inhibitory_learning_rate
f32 eligibility_decay
f32 eligibility_epsilon
f32 surrogate_width
f32 surrogate_gain
f32 max_update
f32 weight_min
f32 weight_max
f32 context_learning_rate

